# 智慧课程平台后端服务 · 环境变量示例
# ---------------------------------------------------------------------------
# 复制为 server/.env 后按需修改。本服务**不会自动读取** .env，启动时用：
#   node --env-file=.env dist/src/index.js
# 或在部署环境（systemd / Docker / shell profile）里直接注入环境变量。
#
# ⚠️ 本文件是示例，且仓库是公开的：
#    - 不要在这里填写任何真实密钥；
#    - 真实 MODEL_API_KEY 只放在服务器环境或密码管理工具里，绝不提交到 Git。

# ---------------------------------------------------------------- 服务监听
# 必须与 Cloudflare API 隧道指向的端口一致（当前为 8080）
PORT=8080

# 默认只监听本机，由 Nginx / 隧道对外；不要在本地开发时改成 0.0.0.0
HOST=127.0.0.1

# ------------------------------------------------------------ 建议接口 provider
# openai-compatible：真实模型（默认，运行时使用）
# mock：仅本地联调，不要用于部署（需要 ADVISOR_PROVIDER=mock 才生效）
ADVISOR_PROVIDER=openai-compatible

# 模型服务地址：必须是【完整请求地址】。
# 服务端不会拼接任何路径，也不会补 /v1 之类的后缀——填什么就请求什么。
# 例：https://your-model-gateway.example.com/v1/chat/completions
MODEL_API_URL=

# 模型密钥：只在服务端读取，不会进响应、日志或前端产物
MODEL_API_KEY=

# 模型名称（网关要求的 model 值）
MODEL_NAME=

# provider 单次调用超时（毫秒），默认 20000；可用范围 100-120000
MODEL_TIMEOUT_MS=20000

# ---------------------------------------------------- 以下仅本地联调时使用
# 仅在 ADVISOR_PROVIDER=mock 时生效：让 mock provider 按指定方式失败，
# 便于前端验证 fallback 与错误状态。
# 取值：ok / empty / invalid / throw / not-configured / slow
# MOCK_PROVIDER_MODE=throw
